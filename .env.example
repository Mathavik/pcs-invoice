# Database (optional — defaults are in Invoice.php for local XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pcs_invoice

# SMTP / PHPMailer (required for invoice emails)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=tls
MAIL_FROM_EMAIL=your-email@example.com
MAIL_FROM_NAME=PCS Invoice
MAIL_SMTP_PASSWORD=your-app-password-here
